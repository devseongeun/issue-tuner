{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["verdict", "source", "channels", "automated_runs", "failed_automated_runs", "residual_risks", "blockers"],
  "additionalProperties": false,
  "properties": {
    "verdict": {"type": "string", "minLength": 1, "enum": ["pass", "fail"]},
    "source": {"type": "string", "minLength": 1, "enum": ["automated", "user_confirmed"]},
    "channels": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "automated_runs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "failed_automated_runs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "residual_risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {
        "properties": {"verdict": {"const": "pass"}, "source": {"const": "automated"}},
        "required": ["verdict", "source"]
      },
      "then": {
        "properties": {
          "automated_runs": {"minItems": 1},
          "failed_automated_runs": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"verdict": {"const": "pass"}, "source": {"const": "user_confirmed"}},
        "required": ["verdict", "source"]
      },
      "then": {
        "properties": {
          "automated_runs": {"maxItems": 0},
          "failed_automated_runs": {"minItems": 1},
          "residual_risks": {"minItems": 1}
        }
      }
    }
  ]
}
